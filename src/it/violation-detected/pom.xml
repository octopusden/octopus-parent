<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.octopusden.octopus</groupId>
        <artifactId>octopus-parent</artifactId>
        <version>@project.version@</version>
    </parent>
    <groupId>org.octopusden.octopus.it</groupId>
    <artifactId>violation-detected</artifactId>
    <version>1.0</version>
    <name>violation-detected</name>
    <description>octopus-parent quality-gate fixture</description>
    <url>https://octopusden.org</url>
    <licenses><license><name>The Apache License, Version 2.0</name><url>http://www.apache.org/licenses/LICENSE-2.0.txt</url></license></licenses>
    <developers><developer><id>octopus</id><name>octopus</name></developer></developers>
    <scm>
        <connection>scm:git:git://github.com/octopusden/octopus-parent.git</connection>
        <developerConnection>scm:git:ssh://github.com:octopusden/octopus-parent.git</developerConnection>
        <url>https://github.com/octopusden/octopus-parent</url>
    </scm>
    <properties>
        <!-- Advisory: the subject is what the reports CONTAIN, so the build must reach the end. -->
        <octopus.quality.failOnViolation>false</octopus.quality.failOnViolation>
    </properties>
    <build>
        <plugins>
            <!-- Reproduces how generated code reaches the analysers: copied UNDER target/generated-sources,
                 which is the part that matters - PMD excludes that directory by root, and Checkstyle filters
                 registered roots inside the build directory. A file kept beside the sources would test
                 something else. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>plant-a-generated-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-sources/fixture</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}/generated-fixture</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>plant-a-generated-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-test-sources/fixture</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}/generated-test-fixture</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>register-generated</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/fixture</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>register-generated-test</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/fixture</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
