<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.octopusden.octopus</groupId>
        <artifactId>octopus-parent</artifactId>
        <version>@project.version@</version>
    </parent>
    <groupId>org.octopusden.octopus.it</groupId>
    <artifactId>plugin-versions-warn-by-default</artifactId>
    <version>1.0</version>
    <name>plugin-versions-warn-by-default</name>
    <description>octopus-parent quality-gate fixture</description>
    <url>https://octopusden.org</url>
    <licenses><license><name>The Apache License, Version 2.0</name><url>http://www.apache.org/licenses/LICENSE-2.0.txt</url></license></licenses>
    <developers><developer><id>octopus</id><name>octopus</name></developer></developers>
    <scm>
        <connection>scm:git:git://github.com/octopusden/octopus-parent.git</connection>
        <developerConnection>scm:git:ssh://github.com:octopusden/octopus-parent.git</developerConnection>
        <url>https://github.com/octopusden/octopus-parent</url>
    </scm>
    <properties>
        <octopus.quality.skip>true</octopus.quality.skip>
    </properties>
    <build>
        <plugins>
            <!-- A consumer's own plugin without a version, which the parent does not manage. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <!-- Declared without a version so the rule inspects them: plugins the parent pins that a jar
                 build does not bind. Each must take its version from the parent and go unreported. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
